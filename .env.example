PORT=3000
NODE_ENV=development

# Railway proporciona DATABASE_URL automáticamente al enlazar PostgreSQL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/tres_pisos
DB_SSL=false

JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:3000

# Solo se usan cuando la tabla usuarios está vacía.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena
